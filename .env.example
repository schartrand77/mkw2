DATABASE_URL="postgresql://postgres:postgres@db:5432/makerworks?schema=public"
JWT_SECRET="replace-with-a-strong-secret"
BASE_URL="http://localhost:3000"
STORAGE_DIR="/app/storage"
# Optional: CDN/object storage base URL for /files (omit to serve from disk).
# FILES_BASE_URL="https://cdn.example.com"
# NEXT_PUBLIC_FILES_BASE_URL="https://cdn.example.com"
# Optional: point uploads to a direct hostname (bypasses Cloudflare/Tunnel limits)
# DIRECT_UPLOAD_URL="https://upload.example.com"
# Optional: upload limits in bytes
# UPLOAD_MAX_FILE_BYTES="209715200"
# UPLOAD_MAX_TOTAL_BYTES="314572800"
# UPLOAD_MAX_3MF_CONVERT_BYTES="26214400"
# UPLOAD_MAX_3MF_TRIANGLES="1200000"
# Options: BAMBU_X1C, BAMBU_P1S, PRUSA_MK4, PRUSA_MK3S, CREALITY_K1_MAX, CREALITY_ENDER3_V2, ANYCUBIC_KOBRA2, GENERIC_FDM
PRINTER_PROFILE="BAMBU_X1C"
# Override if your electricity rate differs from the ~$0.14/kWh default.
# PRINTER_ELECTRIC_RATE_PER_KWH="0.14"
PLA_PRICE_PER_KG_USD="25.00"
PETG_PRICE_PER_KG_USD="28.00"
NEXT_PUBLIC_PLA_PRICE_PER_KG="25.00"
NEXT_PUBLIC_PETG_PRICE_PER_KG="28.00"
COLOR_SURCHARGE_RATE="0.05"
NEXT_PUBLIC_COLOR_SURCHARGE_RATE="0.05"
NEXT_PUBLIC_MAX_CART_COLORS="4"
SUPPORT_OVERHANG_ANGLE_DEG="45"
SUPPORT_VOLUME_MULTIPLIER_MAX="0.6"
COLOR_TIME_MULTIPLIER_PER_COLOR="0.2"
# Optional: per-finish surcharge map (decimal percent).
# Example: {"standard":0,"matte":0.05,"gloss":0.1}
# FINISH_SURCHARGES=""
# NEXT_PUBLIC_FINISH_SURCHARGES=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional: Stripe shipping rate id for flat-rate shipping
STRIPE_SHIPPING_RATE_ID=""
# Optional: MakerWorks inbound secret used by external processors
MAKERWORKS_INBOUND_SECRET=""
# Optional: StockWorks inventory integration for filament availability
STOCKWORKS_BASE_URL="http://host.docker.internal:8000"
STOCKWORKS_ADMIN_USERNAME="admin"
STOCKWORKS_ADMIN_PASSWORD="changeme"
# Optional: Bambu View integration for printer status/queue
# BAMBU_VIEW_BASE_URL="http://host.docker.internal:5080"
# BAMBU_VIEW_SESSION_COOKIE=""
# BAMBU_VIEW_AUTH_HEADER=""
# Optional: override StockWorks color hex values by name (JSON map).
# Example: {"Dark Brown":"#3b2f2f","Light Grey":"#d1d5db"}
# STOCKWORKS_COLOR_OVERRIDES=""
# Optional: warn about low inventory levels (grams).
# STOCKWORKS_LIMITED_THRESHOLD_GRAMS="1000"
# Optional: lead time when out of stock (days).
# STOCKWORKS_OUT_OF_STOCK_LEAD_DAYS="7"
# Optional: per-material lead times (JSON map in days).
# Example: {"PLA":3,"PETG":7}
# STOCKWORKS_MATERIAL_LEAD_DAYS=""
# Currency settings (USD or CAD)
# Server-side pricing logic uses CURRENCY; client display reads NEXT_PUBLIC_CURRENCY
NEXT_PUBLIC_CURRENCY="USD"
CURRENCY="USD"
# Amazon Associates tracking ID used for the /gear referral page
NEXT_PUBLIC_AMAZON_TAG="makerworks02-20"
NEXT_PUBLIC_AMAZON_DOMAIN="amazon.ca"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"
# Branding (set the display name/version to re-theme the UI)
NEXT_PUBLIC_BRAND_NAME="MakerWorks"
NEXT_PUBLIC_BRAND_VERSION="v2"
NEXT_PUBLIC_BRAND_LAB_NAME="MakerWorks lab"
NEXT_PUBLIC_BRAND_HANDLE="@makerworks"
# Email delivery (SMTP settings mirror the OrderWorks app defaults)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="receipts.makerworks@gmail.com"
# SMTP_PASSWORD=""
# SMTP_SECURE="false"
# RECEIPT_FROM_EMAIL="MakerWorks Receipts <receipts.makerworks@gmail.com>"
# RECEIPT_REPLY_TO_EMAIL="MakerWorks <info@makerworks.app>"
# Optional CAD-specific overrides when CURRENCY=CAD (fall back to USD values if unset)
# PLA_PRICE_PER_KG_CAD="30.00"
# PETG_PRICE_PER_KG_CAD="34.00"
# ENERGY_CAD_PER_HOUR="0"
# MACHINE_USD_PER_HOUR="0"
# MACHINE_CAD_PER_HOUR="0"
# LABOR_USD_PER_HOUR="0"
# LABOR_CAD_PER_HOUR="0"
# MINIMUM_PRICE_CAD="0"
# EXTRA_HOURLY_AFTER_FIRST_USD="0"
# EXTRA_HOURLY_AFTER_FIRST_CAD="0"
# Optional seasonal theming.
# Set to christmas, halloween, or easter to enable matching UI flourishes.
HOLIDAY_THEME=""
NEXT_PUBLIC_HOLIDAY_THEME=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"
# Optional: password for admin-created invite accounts (leave blank for random)
# ADMIN_INVITE_PASSWORD="change-me"
INVITE_LOGIN_TOKEN_TTL_HOURS="24"
# Auth rate limiting (seconds)
# AUTH_LOGIN_RATE_WINDOW_SECONDS="900"
# AUTH_LOGIN_RATE_MAX="5"
# AUTH_LOGIN_LOCK_SECONDS="900"
# AUTH_REGISTER_RATE_WINDOW_SECONDS="3600"
# AUTH_REGISTER_RATE_MAX="5"
# AUTH_REGISTER_LOCK_SECONDS="3600"
# AUTH_RESEND_RATE_WINDOW_SECONDS="3600"
# AUTH_RESEND_RATE_MAX="3"
# AUTH_RESEND_LOCK_SECONDS="3600"

# Web push (PWA offline notifications)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Optional: contact email or URL used in VAPID details
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Discord announcements (optional)
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
# Admin Discord notifications (optional, separate channel)
DISCORD_ADMIN_BOT_TOKEN=""
DISCORD_ADMIN_CHANNEL_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_ADMIN_USER_IDS=""

