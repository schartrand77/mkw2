{
  "name": "makerworks-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "next dev",
    "build": "next build",
    "perf:ci": "node scripts/perf-ci.js",
    "prestart": "node scripts/restore.js",
    "start": "next start -p 3000",
    "worker:processing": "tsx scripts/processing-worker.ts",
    "lint": "eslint app components lib scripts tests --ext .ts,.tsx,.js,.mjs --max-warnings=0",
    "a11y:changed": "tsx scripts/a11y-alt-changed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx",
    "test:api": "node --test --import tsx tests/api-integration-flows.test.ts",
    "test:contracts": "node --test --import tsx tests/integration-contracts.test.ts",
    "e2e": "playwright test",
    "prisma:migrate:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "backup": "node scripts/backup.js",
    "backup:scheduler": "node scripts/backup-scheduler.js",
    "backfill:3mf-previews": "node scripts/backfill-3mf-previews.js",
    "bulk:upload-models": "tsx scripts/bulk-upload-models.ts",
    "retention:run": "tsx scripts/data-retention.ts",
    "suite:status": "powershell -ExecutionPolicy Bypass -File scripts/suite-status.ps1",
    "suite:status:prod": "powershell -ExecutionPolicy Bypass -File scripts/suite-status.ps1 -Target production -SshHost makerworks-prod -ProductionComposePath /mnt/cache/appdata/makerworks -MakerWorksUrl http://localhost:3777/api/health -StockWorksUrl http://localhost:8256/ -PrintLabUrl http://localhost:8983/health -OrderWorksUrl http://localhost:3202/ -IncludeDatabase",
    "suite:demo:seed": "tsx scripts/suite-demo-seed.ts",
    "suite:demo:screenshots": "tsx scripts/capture-suite-screenshots.ts",
    "suite:demo:wiki": "tsx scripts/generate-suite-demo-wiki.ts",
    "stockworks:import-bambu-filaments": "tsx scripts/import-bambu-filaments.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.4.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.69.3",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.3.2",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.9.3",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "next": "^16.0.10",
    "nodemailer": "^7.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.4",
    "stripe": "^19.3.1",
    "three": "^0.169.0",
    "tweetnacl": "^1.0.3",
    "unzipper": "^0.12.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@types/unzipper": "^0.10.10",
    "@types/web-push": "^3.6.4",
    "@types/zxcvbn": "^4.4.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.47",
    "prisma": "^5.12.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "bn.js": "^5.2.3",
    "minimatch": "^10.2.2",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "tmp": "^0.2.5"
  }
}
