generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  registrationSource String @default("self_signup")
  registrationIp String?
  registrationUserAgent String?
  lastLoginAt DateTime?
  lastLoginIp String?
  lastLoginUserAgent String?
  emailVerified Boolean  @default(false)
  isSuspended  Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  role         UserRole @default(customer)
  discountPercent        Float   @default(0)
  isFriendsAndFamily     Boolean @default(false)
  friendsAndFamilyPercent Float   @default(0)
  models       Model[]
  comments     ModelComment[]
  likes        Like[]
  verificationTokens VerificationToken[]
  pushSubscriptions PushSubscription[]
  createdAt    DateTime @default(now())
  profile      Profile?
  badges       UserAchievement[]
  jobForms     JobForm[]
  orders       PrintOrder[]
  orderRevisions PrintOrderRevision[]
  orderMessages PrintOrderMessage[] @relation("OrderMessageUser")
  orderApprovalRequests PrintOrderApprovalRequest[] @relation("OrderApprovalRequestedBy")
  downloadReceipts ModelDownload[]
  modelRevisions ModelRevision[]
  configChanges ConfigChangeLog[]
  adminAuditEvents AdminAuditEvent[]
  presets CustomerPreset[]
  failurePhotos FailurePhoto[]
  organizationsCreated Organization[] @relation("OrganizationCreatedBy")
  organizationMemberships OrganizationMember[]

  @@index([lastLoginAt])
}

model Model {
  id             String   @id @default(cuid())
  title          String
  description    String?
  creditName     String?
  creditUrl      String?
  filePath       String
  viewerFilePath String?
  coverImagePath String?
  coverImageStatus String @default("ready")
  coverImageSourcePath String?
  coverImageError String?
  fileType       String
  unit           String   @default("mm")
  material       String   @default("PLA")
  volumeMm3      Float?
  sizeXmm        Float?
  sizeYmm        Float?
  sizeZmm        Float?
  supportRatio   Float?
  priceUsd       Float?
  effectivePriceUsd Float?
  effectivePriceUpdatedAt DateTime?
  salePriceUsd   Float?
  disableCustomerDiscounts Boolean? @default(false)
  flatRatePricing Boolean? @default(false)
  defaultColors  Json?
  colorSlotCount Int?
  allowedColors  Json?
  salePriceIsFrom Boolean  @default(false)
  salePriceUnit   String?
  visibility     String   @default("public")
  downloads      Int      @default(0)
  likes          Int      @default(0)
  printabilityScore Float?
  supportLikelihood Float?
  failureRiskScore Float?
  orientationSuggestion String?
  supportStrategySuggestion String?
  intelligenceUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  affiliateTitle String?
  affiliateUrl   String?
  videoEmbedId   String?
  images         ModelImage[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  modelTags ModelTag[]
  likesList Like[]
  featured  FeaturedModel?
  parts     ModelPart[]
  comments  ModelComment[]
  downloadReceipts ModelDownload[]
  revisions ModelRevision[]
  collectionEntries CollectionModel[]
  previewJobs ModelPreviewJob[]
  productTemplates ProductTemplate[]
  failurePhotos FailurePhoto[]

  @@index([effectivePriceUsd])
  @@index([visibility])
  @@index([createdAt])
  @@index([likes])
  @@index([downloads])
  @@index([material])
}

model Collection {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  kind          String   @default("curated")
  materialKey   String?
  heroImagePath String?
  position      Int      @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  models CollectionModel[]

  @@index([isActive])
  @@index([kind])
  @@index([materialKey])
  @@index([position])
}

model CollectionModel {
  collectionId String
  modelId      String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  model      Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([collectionId, modelId])
  @@index([collectionId, position])
}

model ModelImage {
  id        String   @id @default(cuid())
  modelId   String
  filePath  String
  sourcePath String?
  status    String   @default("ready")
  error     String?
  caption   String?
  sortOrder BigInt   @default(0)
  createdAt DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Tag {
  id      String     @id @default(cuid())
  name    String     @unique
  slug    String     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modelTags ModelTag[]

  @@index([slug])
}

model ModelTag {
  modelId String
  tagId   String
  model   Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([modelId, tagId])
  @@index([tagId])
}

model Like {
  userId  String
  modelId String
  createdAt DateTime @default(now())
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model   Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  @@id([userId, modelId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id])
}

model Profile {
  id               String   @id @default(cuid())
  slug             String   @unique
  bio              String?
  avatarImagePath  String?
  avatarImageStatus String  @default("ready")
  avatarImageSourcePath String?
  avatarImageError String?
  contactEmail     String?
  contactPhone     String?
  websiteUrl       String?
  socialTwitter    String?
  socialInstagram  String?
  socialTikTok     String?
  socialYoutube    String?
  socialBluesky    String?
  socialFacebook   String?
  shippingName     String?
  shippingAddress1 String?
  shippingAddress2 String?
  shippingCity     String?
  shippingState    String?
  shippingPostal   String?
  shippingCountry  String?
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model FeaturedModel {
  modelId   String   @id
  position  Int      @default(0)
  createdAt DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model SiteConfig {
  id                       String   @id
  allowAnonymousUploads    Boolean? @default(true)
  allowModelDownloads      Boolean? @default(true)
  directUploadUrl          String?
  favoriteShopLinkIds      Json?
  showApplePayBadge        Boolean? @default(false)
    showGooglePayBadge       Boolean? @default(false)
    printSpeedCm3PerHour     Float?
  energyUsdPerHour         Float?
  machineUsdPerHour        Float?
  laborUsdPerHour          Float?
  minimumPriceUsd          Float?
  minimumOrderSubtotalUsd  Float?
  minimumOrderNotes        String?
  printTimeCorrectionFactor Float?
  extraHourlyUsdAfterFirst Float?
  plaPricePerKgUsd         Float?
  petgPricePerKgUsd        Float?
  absPricePerKgUsd         Float?
  asaPricePerKgUsd         Float?
  tpuPricePerKgUsd         Float?
  pa6PricePerKgUsd         Float?
  pa12PricePerKgUsd        Float?
  nylonPricePerKgUsd       Float?
  pcPricePerKgUsd          Float?
  resinPricePerKgUsd       Float?
  fillFactor               Float?
  printerProfileKey        String?
  printerProfileOverrides  Json?
  productsModelsLabel      String?
  productsMerchLabel       String?
  demandSurgeMultiplier    Float?
  rushMultiplier           Float?
  batchDiscountTiers       Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ProductTemplate {
  id           String   @id @default(cuid())
  title        String
  description  String?
  baseModelId  String?
  stockworksCategory String? @default("models")
  stockworksSku String?
  stockworksDesigner String?
  stockworksMarketplace String?
  stockworksFileLocation String?
  stockworksVersion String?
  stockworksUnitPriceUsd Float?
  stockworksStatus String? @default("Active")
  stockworksNotes String?
  lockedMaterial String? @default("PLA")
  lockedColor   String?
  lockedColorCount Int   @default(1)
  lockedScale   Float    @default(1)
  lockedFinish  String?  @default("standard")
  lockedPriceMultiplier Float @default(1)
  stockworksMaterialId Int?
  stockworksInventoryItemId Int?
  stockworksVariantMap Json?
  materialOptions Json?
  colorOptions Json?
  sizeOptions  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  baseModel Model? @relation(fields: [baseModelId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([createdAt])
}

model MerchItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("Merch")
  availability String  @default("in_stock")
  priceUsd    Float?
  sizeOptions Json?
  colorOptions Json?
  galleryImageUrls Json?
  stockworksCategory String? @default("merch")
  stockworksStatus String? @default("Active")
  stockworksNotes String?
  stockworksVariantMap Json?
  imageUrl    String?
  externalUrl String?
  ctaLabel    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  notifyRequests MerchNotifyRequest[]

  @@index([isActive])
  @@index([category])
  @@index([sortOrder])
}

model MerchNotifyRequest {
  id          String    @id @default(cuid())
  merchItemId String
  email       String
  name        String?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  merchItem MerchItem @relation(fields: [merchItemId], references: [id], onDelete: Cascade)

  @@unique([merchItemId, email])
  @@index([merchItemId, notifiedAt])
  @@index([createdAt])
}

model CustomerPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PricingProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Printer {
  id                 String   @id @default(cuid())
  name               String
  provider           String   @default("local")
  externalId         String?
  status             String   @default("available")
  active             Boolean  @default(true)
  dailyCapacityHours Float    @default(8)
  notes              String?
  lastMaintenanceAt  DateTime?
  maintenanceIntervalHours Float?
  maintenanceNotes   String?
  metadata           Json?
  lastSeenAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders             PrintOrder[]
  failurePhotos      FailurePhoto[]

  @@index([status])
  @@index([active])
}

model ModelPart {
  id         String   @id @default(cuid())
  modelId    String
  name       String
  index      Int      @default(0)
  filePath   String
  previewFilePath String?
  volumeMm3  Float?
  sizeXmm    Float?
  sizeYmm    Float?
  sizeZmm    Float?
  supportRatio Float?
  priceUsd   Float?
  createdAt  DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  previewJobs ModelPreviewJob[]
}

model ModelPreviewJob {
  id         String   @id @default(cuid())
  modelId    String
  partId     String?
  sourcePath String
  previewPath String
  status     String   @default("pending")
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  part  ModelPart? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([modelId])
}

model ModelRevision {
  id            String   @id @default(cuid())
  modelId       String
  userId        String?
  label         String?
  note          String?
  filePath      String
  viewerFilePath String?
  fileType      String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  parts ModelRevisionPart[]

  @@index([modelId])
  @@index([createdAt])
}

model ModelRevisionPart {
  id         String   @id @default(cuid())
  revisionId String
  name       String
  index      Int      @default(0)
  filePath   String
  previewFilePath String?
  volumeMm3  Float?
  sizeXmm    Float?
  sizeYmm    Float?
  sizeZmm    Float?
  createdAt  DateTime @default(now())

  revision ModelRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
}

model ModelComment {
  id        String   @id @default(cuid())
  modelId   String
  userId    String
  body      String
  partId    String?
  partName  String?
  pinX      Float?
  pinY      Float?
  pinZ      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String   @default("comment")
  isHomeCurated Boolean @default(false)
  imagePath String?
  imageStatus String @default("ready")
  imageSourcePath String?
  imageError String?
  imageWidth Int?
  imageHeight Int?

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([userId])
  @@index([isHomeCurated, createdAt])
}

model ModelDownload {
  id        String   @id @default(cuid())
  modelId   String
  userId    String
  createdAt DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
  @@index([userId])
}

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  icon        String?
  description String?
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model JobForm {
  id              String   @id @default(cuid())
  paymentIntentId String   @unique
  userId          String?
  customerEmail   String?
  lineItems       Json
  shipping        Json?
  metadata        Json?
  totalCents      Int
  currency        String
  status          String   @default("pending")
  paymentMethod   String?  @map("payment_method")
  paymentStatus   String?  @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(pending) @map("fulfillment_status")
  fulfilledAt     DateTime? @map("fulfilled_at")
  webhookAttempts Int      @default(0)
  lastAttemptAt   DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model RateLimit {
  key          String   @id
  count        Int      @default(0)
  resetAt      DateTime
  blockedUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([resetAt])
  @@index([blockedUntil])
}

enum FulfillmentStatus {
  pending
  ready
  picked_up
  shipped
}

enum UserRole {
  admin
  staff
  customer
}

model PrintOrder {
  id              String   @id @default(cuid())
  orderNumber     Int      @default(autoincrement()) @unique
  userId          String?
  customerEmail   String?
  customerName    String?
  status          String   @default("awaiting_review")
  paymentMethod   String   @default("card")
  shippingMethod  String   @default("pickup")
  shippingAddress Json?
  subtotalCents   Int
  discountPercent Float?
  totalCents      Int
  currency        String   @default("USD")
  notes           String?
  metadata        Json?
  printerId       String?
  printerAssignedAt DateTime?
  printerAssignedBy String?
  failedAt        DateTime?
  failureNote     String?
  reprintOfId     String?
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  printer   Printer?     @relation(fields: [printerId], references: [id], onDelete: SetNull)
  items     PrintOrderItem[]
  revisions PrintOrderRevision[]
  messages PrintOrderMessage[]
  approvalRequests PrintOrderApprovalRequest[]
  reprintOf PrintOrder?   @relation("ReprintSource", fields: [reprintOfId], references: [id])
  reprints  PrintOrder[]  @relation("ReprintSource")
  failurePhotos FailurePhoto[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Organization {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  billingEmail             String?
  billingContact           String?
  quoteApprovalRequired    Boolean  @default(true)
  requirePoAboveCents      Int?
  procurementConfig        Json?
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  createdBy User @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  orders  PrintOrder[]

  @@index([createdById])
  @@index([name])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("requester")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model FailurePhoto {
  id           String   @id @default(cuid())
  filePath     String
  originalName String?
  label        String
  confidence   Float?
  signals      Json?
  note         String?
  sizeBytes    Int?
  width        Int?
  height       Int?
  orderId      String?
  printerId    String?
  modelId      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  order      PrintOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printer    Printer?    @relation(fields: [printerId], references: [id], onDelete: SetNull)
  model      Model?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([label])
  @@index([createdAt])
  @@index([orderId])
  @@index([printerId])
  @@index([modelId])
}

model PrintOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  modelId        String?
  modelTitle     String
  partId         String?
  partName       String?
  material       String
  colors         Json?
  infillPct      Int?
  finish         String?
  customNotes    String?
  quantity       Int      @default(1)
  unitPriceCents Int
  totalCents     Int
  configuration  Json?
  thumbnailPath  String?
  viewerPath     String?
  createdAt      DateTime @default(now())

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PrintOrderRevision {
  id         String   @id @default(cuid())
  orderId    String
  userId     String?
  label      String?
  note       String?
  filePath   String
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PrintOrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  userId     String?
  senderRole String   @default("shop")
  body       String
  createdAt  DateTime @default(now())

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?      @relation("OrderMessageUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model PrintOrderApprovalRequest {
  id            String   @id @default(cuid())
  orderId       String
  requestedById String?
  status        String   @default("pending")
  message       String
  responseNote  String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())

  order       PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User?      @relation("OrderApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model ConfigChangeLog {
  id        String   @id @default(cuid())
  adminId   String
  section   String
  changes   Json
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@index([section])
}

model AdminAuditEvent {
  id            String   @id @default(cuid())
  adminId       String?
  adminEmail    String?
  adminName     String?
  action        String
  targetType    String?
  targetId      String?
  requestMethod String
  requestPath   String
  requestIp     String?
  userAgent     String?
  metadata      Json?
  prevHash      String?
  eventHash     String   @unique
  createdAt     DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
